  <bpmn:process id="DiscountApproved" name="Discount Approved" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1c0tpm0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1c0tpm0" sourceRef="StartEvent_1" targetRef="Activity_00gs1c7" />
    <bpmn:scriptTask id="Activity_00gs1c7" name="calculate Discount Rate" scriptFormat="JavaScript" camunda:resource="Test.js">
      <bpmn:incoming>Flow_1c0tpm0</bpmn:incoming>
      <bpmn:outgoing>Flow_0iwwoxr</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1ok9r7a" name="Discount &#62; 20%">
      <bpmn:incoming>Flow_0iwwoxr</bpmn:incoming>
      <bpmn:outgoing>Flow_0x4gjdq</bpmn:outgoing>
      <bpmn:outgoing>Flow_1b7qr5g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0iwwoxr" sourceRef="Activity_00gs1c7" targetRef="Gateway_1ok9r7a" />
    <bpmn:sequenceFlow id="Flow_0x4gjdq" name="YES" sourceRef="Gateway_1ok9r7a" targetRef="Activity_0b522ob">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${discount&gt;20}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_0b522ob" name="Manager Approval" camunda:assignee="Manager">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="Approved" label="Approve request?" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0x4gjdq</bpmn:incoming>
      <bpmn:outgoing>Flow_0hem0ac</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1xrrzhk" name="approved?">
      <bpmn:incoming>Flow_0hem0ac</bpmn:incoming>
      <bpmn:outgoing>Flow_12fgckf</bpmn:outgoing>
      <bpmn:outgoing>Flow_1c0w0bx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0hem0ac" sourceRef="Activity_0b522ob" targetRef="Gateway_1xrrzhk" />
    <bpmn:sequenceFlow id="Flow_12fgckf" name="YES" sourceRef="Gateway_1xrrzhk" targetRef="Activity_12ko6l0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${Approved==true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Activity_144w3c7" name="Rejected">
      <bpmn:incoming>Flow_1c0w0bx</bpmn:incoming>
      <bpmn:outgoing>Flow_0rjshix</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1c0w0bx" name="NO" sourceRef="Gateway_1xrrzhk" targetRef="Activity_144w3c7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${Approved==false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1ayor2b">
      <bpmn:incoming>Flow_0rjshix</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0rjshix" sourceRef="Activity_144w3c7" targetRef="Event_1ayor2b" />
    <bpmn:sequenceFlow id="Flow_1b7qr5g" sourceRef="Gateway_1ok9r7a" targetRef="Activity_12ko6l0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${discount&lt;=20}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0zlwm5j">
      <bpmn:incoming>Flow_1f9edx3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1f9edx3" sourceRef="Activity_12ko6l0" targetRef="Event_0zlwm5j" />
    <bpmn:serviceTask id="Activity_12ko6l0" name="Process Payment &#38; Notify" camunda:delegateExpression="${processDelegate}">
      <bpmn:incoming>Flow_12fgckf</bpmn:incoming>
      <bpmn:incoming>Flow_1b7qr5g</bpmn:incoming>
      <bpmn:outgoing>Flow_1f9edx3</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
